# Copy to .env and change the secrets before deploying.

# Shared by auth-service (signs tokens) and game-service / stats-service (verify them).
JWT_SECRET=change-me-to-a-long-random-string

POSTGRES_USER=wordroyale
POSTGRES_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Where CI/CD pushes images (GitHub Container Registry). Lowercase.
REGISTRY=ghcr.io/your-github-username
TAG=latest

# Game tuning (optional). Round order: word chain, letter builder, speed round.
ROUND_DURATIONS_MS=45000,60000,20000
INTERMISSION_MS=7000
RECONNECT_GRACE_MS=30000

# --- Endpoints & secrets ---------------------------------------------------------------------------------------
# Locally the defaults point at the compose containers. In the cloud the same images get managed private endpoints,
# injected at runtime from Secret Manager (see docs/deployment-gcp.md); never bake real values into an image.
#   GAME_REDIS_URL=redis://10.0.0.5:6379
#   GAME_DATABASE_URL=postgres://user:pass@10.0.0.3:5432/game_db
# Any secret can also be given as a file: JWT_SECRET_FILE=/run/secrets/jwt_secret, DATABASE_URL_FILE=..., REDIS_URL_FILE=...
