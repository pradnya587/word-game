# Only used when you run the frontend alone with `npm run dev`.
# Point these at the gateway (docker compose publishes it on port 80).
# Inside docker compose the build passes empty values (same origin), so you do not need this file there.
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SOCKET_URL=http://localhost
# true = UI works with no backend at all (fake login). false = use the real services.
NEXT_PUBLIC_MOCK=false
